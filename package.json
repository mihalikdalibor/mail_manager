{
  "name": "mail-manager",
  "version": "0.0.1",
  "private": true,
  "description": "IMAP mailbox manager: filters, size insight, safe delete, backup",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "mm": "dist/cli/bin.js"
  },
  "scripts": {
    "dev": "tsx src/cli/bin.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli/bin.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "dotenv": "^18.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
