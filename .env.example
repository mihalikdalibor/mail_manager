# Copy to .env.local (preferred, loaded first) or .env and fill in. Never commit either.
# Precedence: real environment variables > .env.local > .env
# Check your setup with: mm doctor   (or: npm run dev -- doctor)

# --- Supabase (cloud project, EU region recommended) ---
# Project URL, e.g. https://xxxx.supabase.co  (Project Settings → API)
SUPABASE_URL=
# Publishable key (sb_publishable_…, formerly "anon"). Safe on clients ONLY because every table has RLS.
SUPABASE_PUBLISHABLE_KEY=
# Secret / service-role key: server-side worker only (M6+). Never used by the CLI.
# SUPABASE_SECRET_KEY=

# --- Credential encryption ---
# 32 random bytes, base64. Generate with: mm keygen
# Losing this key = all stored mailbox passwords must be re-entered.
MM_MASTER_KEY=
# Version of the key above; bump when rotating. Defaults to 1.
MM_MASTER_KEY_VERSION=1

# --- Local session location (optional) ---
# Default: $XDG_CONFIG_HOME/mail-manager or ~/.config/mail-manager (session.json, mode 600)
# Must be a dedicated directory: it is chmod-ed to 700.
# MM_CONFIG_DIR=

# --- Supabase integration tests (optional; the RLS suite skips when unset) ---
# Two DIFFERENT auto-confirmed users created in the Supabase dashboard (test-only accounts).
MM_TEST_SUPABASE_A_EMAIL=
MM_TEST_SUPABASE_A_PASSWORD=
MM_TEST_SUPABASE_B_EMAIL=
MM_TEST_SUPABASE_B_PASSWORD=

# --- IMAP integration tests (optional; tests skip when unset) ---
# Use a DEDICATED THROWAWAY mailbox. Tests only touch the "mm-test" folder.
# MM_TEST_IMAP_USER alone enables the discovery test (live DNS, no login).
MM_TEST_IMAP_HOST=
MM_TEST_IMAP_PORT=993
MM_TEST_IMAP_USER=
MM_TEST_IMAP_PASS=
